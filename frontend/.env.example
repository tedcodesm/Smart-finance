# Frontend dev-server config (Vite reads THIS file, not the repo-root .env).

# Origin the /api proxy forwards to. Must match the port uvicorn is bound to.
VITE_BACKEND_ORIGIN=http://127.0.0.1:8000

# Seeded demo account shown on the login screen. Must match DEMO_EMAIL /
# DEMO_PASSWORD in the repo-root .env, otherwise "Fill" signs in with the
# wrong credentials.
VITE_DEMO_EMAIL=demo@example.com
VITE_DEMO_PASSWORD=demopassword1
