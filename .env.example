# ---------------------------------------------------------------------------
# Mercy - personal finance + ML.  Copy to `.env` and adjust.
# ---------------------------------------------------------------------------

# --- App ---
APP_NAME="Mercy"
ENVIRONMENT=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=mercy
# MONGO_URI=mongodb://user:password@host:27017/?authSource=admin
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# --- Database mode ---
# IN_MEMORY_DB=true swaps MongoDB for an in-process `mongomock` database. Useful
# for demos and throwaway runs with no MongoDB installed, but the data lives in
# RAM only and is lost when the process exits. Leave false to use MONGO_URI.
IN_MEMORY_DB=false
# Seed the demo account + 8 months of history. Only applies when IN_MEMORY_DB=true.
SEED_DEMO_DATA=true
# Must satisfy the same policy as POST /auth/register: >= PASSWORD_MIN_LENGTH
# characters including at least one letter and one digit.


# --- Auth / JWT ---
# CHANGE THIS. Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-only-insecure-secret-change-me-0000000000000000
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_MIN_LENGTH=8
BCRYPT_ROUNDS=12

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- Finance domain defaults ---
DEFAULT_CURRENCY=KES
BUDGET_ALERT_THRESHOLD_PCT=0.8

# --- Reports ---
REPORT_RETENTION_DAYS=365
PREDICTION_RETENTION_DAYS=180

# --- Scheduler ---
ENABLE_SCHEDULER=true
SCHEDULER_TIMEZONE=UTC
ML_BATCH_HOUR=2              # nightly ML batch (24h clock)
ML_BATCH_MINUTE=17
ALERT_SWEEP_HOUR=7           # daily goal-deadline / reminder sweep
ALERT_SWEEP_MINUTE=23

# --- ML ---
ML_ARTIFACT_DIR=../ml/artifacts
ML_RANDOM_SEED=42
ML_TRAIN_FRACTION=0.8
